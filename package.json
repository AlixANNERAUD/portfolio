{
  "name": "alix-anneraud-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:types": "astro check",
    "test:unit": "node --test 'scripts/*.test.mjs'",
    "snapshot": "node scripts/snapshot-dist.mjs",
    "check": "npm run format:check && npm run check:types && npm run test:unit && npm run validate:portfolio && npm run build && npm run verify:static && node scripts/snapshot-dist.mjs --compare --fields=file,canonical,hreflang,robots,lang",
    "validate:portfolio": "node scripts/validate-portfolio.mjs",
    "verify:static": "node scripts/check-static-seo.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.66.0",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "node-html-parser": "^9.0.5",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
