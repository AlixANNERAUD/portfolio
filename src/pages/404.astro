---
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations } from "../i18n/ui.ts";

const t = useTranslations("en");
---

<BaseLayout
  lang="en"
  path="/404"
  title={t("notFound.title")}
  description={t("notFound.description")}
>
  <section class="prose">
    <h1>Page not found / Page introuvable</h1>
    <p>The page you requested does not exist. Cette page n'existe pas.</p>
    <a href="/">Back to homepage</a> · <a href="/fr/">Retour à l'accueil</a>
  </section>
</BaseLayout>
