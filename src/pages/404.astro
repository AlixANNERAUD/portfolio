---
import BaseLayout from "../layouts/BaseLayout.astro";
import { locales, localizePath } from "../i18n/locales.ts";
import { useTranslations } from "../i18n/ui.ts";

// GitHub Pages serves this single file for unknown paths in both locales,
// so it speaks both languages and stays out of the index.
const t = useTranslations("en");
const sections = locales.map((lang) => ({
  lang,
  t: useTranslations(lang),
  home: localizePath("/", lang),
}));
---

<BaseLayout
  lang="en"
  path="/404"
  title={t("notFound.title")}
  description={t("notFound.description")}
  noindex
>
  <div class="prose">
    <h1>
      {sections.map(({ lang, t }, index) => (
        <>
          {index > 0 && " / "}
          <span lang={lang}>{t("notFound.title")}</span>
        </>
      ))}
    </h1>
    {sections.map(({ lang, t, home }) => (
      <section lang={lang}>
        <p>{t("notFound.body")}</p>
        <p>
          <a href={home}>{t("notFound.back")}</a>
        </p>
      </section>
    ))}
  </div>
</BaseLayout>
