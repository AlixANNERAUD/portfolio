---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/ui/Hero.astro";
import NextLink from "../../components/ui/NextLink.astro";
import ExperienceTimeline from "../../components/experience/ExperienceTimeline.astro";
import { experiences, type ExperienceGroup } from "../../data/experiences.ts";
import { localeStaticPaths, localizePath } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

export const getStaticPaths = (() =>
  localeStaticPaths()) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const t = useTranslations(lang);

const groups: readonly ExperienceGroup[] = ["professional", "education"];
const navItems = groups.map((group) => ({
  href: `#${group}`,
  label: t(`experiences.${group}.title`),
}));
const creditsHref = `${localizePath("/legal-notice", lang)}#${t("legal.logoCreditsId")}`;
---

<BaseLayout
  lang={lang}
  path="/experiences"
  title={t("nav.experiences")}
  description={t("experiences.description")}
>
  <div class="career-showcase editorial-page">
    <Hero
      eyebrow={t("experiences.eyebrow")}
      title={t("experiences.title")}
      accent={t("experiences.accent")}
      intro={t("experiences.intro")}
      navLabel={t("experiences.navLabel")}
      navItems={navItems}
    />

    {groups.map((group, index) => (
      <ExperienceTimeline
        group={group}
        index={index + 1}
        entries={experiences.filter((entry) => entry.group === group)}
        lang={lang}
      />
    ))}

    <NextLink
      eyebrow={t("next.eyebrow")}
      title={t("experiences.nextTitle")}
      description={t("experiences.nextDescription")}
      href={localizePath("/projects", lang)}
      linkLabel={t("experiences.nextLink")}
    />
    <p class="career-logo-credits">
      <a href={creditsHref}>{t("experiences.logoCredits")} ↗</a>
    </p>
  </div>
</BaseLayout>

<style>
  .career-logo-credits {
    margin: 0;
    color: var(--vp-c-text-3);
    font-size: 0.72rem;
  }
  .career-logo-credits a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .career-logo-credits a:hover {
    color: var(--vp-c-text-1);
  }
</style>
