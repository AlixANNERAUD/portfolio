---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeHero from "../../components/home/HomeHero.astro";
import HomeExperience from "../../components/home/HomeExperience.astro";
import FeaturedProjects from "../../components/home/FeaturedProjects.astro";
import XilaTopology from "../../components/xila/XilaTopology.astro";
import { localeStaticPaths } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";
import { personLd, profilePageLd, websiteLd } from "../../lib/seo.ts";

export const getStaticPaths = (() =>
  localeStaticPaths()) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const t = useTranslations(lang);

// Page order is the single source of the section numbers (00, 01, …).
const sections = [HomeHero, HomeExperience, FeaturedProjects, XilaTopology];
---

<BaseLayout
  lang={lang}
  path="/"
  description={t("home.description")}
  home
  jsonLd={[personLd(lang), websiteLd(), profilePageLd(lang)]}
>
  {sections.map((Section, index) => (
    <Section lang={lang} index={index} />
  ))}
</BaseLayout>
