---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeHero from "../../components/home/HomeHero.astro";
import HomeExperience from "../../components/home/HomeExperience.astro";
import FeaturedProjects from "../../components/home/FeaturedProjects.astro";
import XilaTopology from "../../components/xila/XilaTopology.astro";
import { personJsonLd } from "../../data/jsonLd.ts";
import { localeStaticPaths } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

export const getStaticPaths = (() =>
  localeStaticPaths()) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path="/"
  description={t("home.description")}
  home
  jsonLd={[personJsonLd]}
>
  <HomeHero lang={lang} />
  <HomeExperience lang={lang} />
  <FeaturedProjects lang={lang} />
  <XilaTopology lang={lang} />
</BaseLayout>
