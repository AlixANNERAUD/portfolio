---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomeOrbit from "../../components/home/HomeOrbit.astro";
import HomeNow from "../../components/home/HomeNow.astro";
import { localeStaticPaths } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";
import { personLd, profilePageLd, websiteLd } from "../../lib/seo.ts";

export const getStaticPaths = (() =>
  localeStaticPaths()) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const t = useTranslations(lang);

// Page order is the single source of the section numbers (00, 01, …).
const sections = [HomeOrbit, HomeNow];
---

<BaseLayout
  lang={lang}
  path="/"
  description={t("home.description")}
  home
  jsonLd={[personLd(lang), websiteLd(), profilePageLd(lang)]}
>
  {sections.map((Section, index) => (
    <Section lang={lang} index={index} />
  ))}
</BaseLayout>
