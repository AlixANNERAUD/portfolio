---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import { getProject, isProjectId } from "../../../data/projects.ts";
import { locales, toParam, type Locale } from "../../../i18n/locales.ts";

export const getStaticPaths = (async () => {
  const entries = await getCollection("projects");
  return entries.map((entry) => {
    const [lang, ...rest] = entry.id.split("/") as [Locale, ...string[]];
    return {
      params: { lang: toParam(lang), slug: rest.join("/") },
      props: { entry, lang },
    };
  });
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry, lang } = Astro.props;
const { slug } = Astro.params;
// hreflang points to the other locale: fail the build if that page is missing.
for (const other of locales.filter((locale) => locale !== lang)) {
  if (!(await getEntry("projects", `${other}/${slug}`))) {
    throw new Error(`Project "${entry.id}" has no ${other} counterpart`);
  }
}
if (!isProjectId(slug)) {
  throw new Error(`Project page "${entry.id}" has no metadata`);
}
const project = getProject(slug);
// remark-project-title lifts the Markdown H1 into the layout header.
const { Content, remarkPluginFrontmatter } = await render(entry);
const heading: string = remarkPluginFrontmatter.pageTitle ?? entry.data.title;
---

<ProjectLayout
  lang={lang}
  project={project}
  heading={heading}
  title={entry.data.title}
  description={entry.data.description}
>
  <Content />
</ProjectLayout>
