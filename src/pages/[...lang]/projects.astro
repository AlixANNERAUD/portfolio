---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCatalogue from "../../components/projects/ProjectCatalogue.astro";
import { localeStaticPaths } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

export const getStaticPaths = (() =>
  localeStaticPaths()) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  path="/projects"
  title={t("projects.metaTitle")}
  trail={[{ name: t("nav.projects"), path: "/projects" }]}
  description={t("projects.description")}
>
  <ProjectCatalogue lang={lang} />
</BaseLayout>
