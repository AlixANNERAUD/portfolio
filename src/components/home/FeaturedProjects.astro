---
import Hero from "../ui/Hero.astro";
import ProjectCard from "../projects/ProjectCard.astro";
import { featuredProjects } from "../../data/projects.ts";
import { localizePath, type Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

/** Homepage selection: the top-ranked projects, then a link to the catalogue. */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="portfolio-showcase" aria-label={t("home.projects.label")}>
  <Hero
    variant="compact"
    headingLevel="h2"
    eyebrow={t("home.projects.eyebrow")}
    title={t("home.projects.title")}
    accent={t("home.projects.accent")}
    intro={t("home.projects.intro")}
  />

  <div class="showcase-grid">
    {featuredProjects.map((project) => (
      <ProjectCard project={project} lang={lang} />
    ))}
  </div>

  <a class="showcase-all-link" href={localizePath("/projects", lang)}>
    {t("home.projects.viewAll")} <span aria-hidden="true">→</span>
  </a>
</section>

<style>
  .portfolio-showcase {
    margin-block: 2.5rem 5rem;
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .showcase-all-link {
    display: inline-block;
    margin-top: 1.7rem;
    color: var(--color-accent);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .showcase-all-link:hover {
    text-decoration: underline;
  }
  @media (max-width: 850px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .portfolio-showcase {
      margin-block: 2rem 3rem;
    }
    .showcase-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
