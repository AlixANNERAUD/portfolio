---
import Hero from "../ui/Hero.astro";
import ProjectCard from "../projects/ProjectCard.astro";
import { featuredProjects, projects } from "../../data/projects.ts";
import { localizePath, type Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

/** Homepage selection: the top-ranked projects, then a link to the catalogue. */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="portfolio-showcase" aria-label={t("home.projects.label")}>
  <Hero
    variant="compact"
    headingLevel="h2"
    eyebrow={t("home.projects.eyebrow")}
    title={t("home.projects.title")}
    accent={t("home.projects.accent")}
    intro={t("home.projects.intro")}
  />

  <div class="showcase-grid">
    {featuredProjects.map((project) => (
      <ProjectCard project={project} lang={lang} />
    ))}
  </div>

  <a class="showcase-all-link" href={localizePath("/projects", lang)}>
    {t("home.projects.viewAll", { count: projects.length })}{" "}
    <span aria-hidden="true">→</span>
  </a>
</section>

<style>
  .portfolio-showcase {
    margin-block: var(--space-l) var(--space-2xl);
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
  }
  .showcase-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: var(--space-m);
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }
  .showcase-all-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .showcase-all-link span {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .showcase-all-link:hover span {
      transform: translateX(3px);
    }
  }
  @media (max-width: 850px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .portfolio-showcase {
      margin-block: var(--space-l) var(--space-xl);
    }
    .showcase-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
