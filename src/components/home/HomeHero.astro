---
import { site } from "../../data/site.ts";
import { localizePath, type Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const actions = [
  {
    label: t("home.hero.experience"),
    href: localizePath("/experiences", lang),
    primary: true,
  },
  {
    label: t("home.hero.projects"),
    href: localizePath("/projects", lang),
    primary: false,
  },
  {
    label: t("home.hero.contact"),
    href: `mailto:${site.email}`,
    primary: false,
  },
];
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero-inner">
    <div class="home-hero-overline" aria-hidden="true">
      <span class="home-hero-overline-index">{t("home.hero.index")}</span>
      <span class="home-hero-overline-discipline">
        {t("home.hero.discipline")}
      </span>
    </div>

    <div class="home-hero-content">
      <h1 id="home-hero-title" class="home-hero-title">
        <span class="home-hero-name">
          <span class="home-hero-name-text">{site.name}</span>
          <span class="visually-hidden">,</span>
          <span class="home-hero-name-divider" aria-hidden="true"></span>
          <span class="home-hero-name-job">{t("home.hero.job")}</span>
          <span class="visually-hidden">.</span>
        </span>
        <span class="home-hero-title-mask">
          <span class="home-hero-title-line">{t("home.hero.lineOne")}</span>
        </span>
        <span class="home-hero-title-mask">
          <span class="home-hero-title-line home-hero-title-line--accent">
            <em>{t("home.hero.lineTwo")}</em>
          </span>
        </span>
      </h1>

      <div class="home-hero-bottom-row">
        <p class="home-hero-tagline">{t("home.hero.summary")}</p>
        <nav class="home-hero-actions" aria-label={t("home.hero.actionsLabel")}>
          {actions.map((action) => (
            <a
              href={action.href}
              class:list={[
                "home-action",
                { "home-action--primary": action.primary },
              ]}
            >
              {action.label}
              <span class="home-action-icon" aria-hidden="true">
                ↗
              </span>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <div class="home-hero-footer">
      <a
        class="home-hero-scroll"
        href="#career-highlights"
        aria-label={t("home.hero.scroll")}
      >
        <span class="home-hero-scroll-icon" aria-hidden="true">
          ↓
        </span>
        <span>{t("home.hero.scrollLabel")}</span>
      </a>
      <span class="home-hero-footer-note" aria-hidden="true">
        {t("home.hero.footnote")}
      </span>
    </div>
  </div>
</section>

<style>
  /* Full-screen typographic introduction: no portraits, videos, WebGL or JS. */
  .home-hero {
    position: relative;
    display: flex;
    /* Fill exactly what the sticky header leaves (one or two rows). */
    min-height: calc(100svh - var(--header-h));
    isolation: isolate;
    overflow: clip;
    color: var(--color-text);
  }

  /* A restrained wash replaces the previous image's halo without reading as artwork. */
  .home-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 56% 60% at 82% 47%,
      color-mix(in srgb, var(--color-accent) 7%, transparent) 0%,
      transparent 78%
    );
  }

  .home-hero-inner {
    display: flex;
    flex-direction: column;
    width: min(100%, var(--container));
    min-width: 0;
    margin-inline: auto;
    padding: clamp(var(--space-s), 3.6vh, var(--space-l)) var(--space-m);
  }

  .home-hero-overline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: var(--space-xs);
    position: relative;
    color: var(--color-text-muted);
    font-size: var(--step--2);
    font-weight: 650;
    letter-spacing: var(--tracking-overline);
    line-height: 1.5;
    text-transform: uppercase;
  }

  .home-hero-overline::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--color-border);
    transform-origin: left;
  }

  .home-hero-content {
    display: grid;
    align-content: center;
    flex: 1;
    min-width: 0;
    padding-block: clamp(var(--space-l), 6vh, var(--space-3xl));
  }

  .home-hero-title {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-size: var(--step-display);
    font-weight: 400;
    line-height: 1.045;
    letter-spacing: var(--tracking-display);
  }

  /* First line of the H1, styled as the eyebrow: the name stays in the
     page heading without competing with the display lines. */
  .home-hero-name {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-xs);
    margin: 0 0 clamp(var(--space-s), 2.5vh, var(--space-l));
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }
  .home-hero-name-text {
    color: var(--color-text);
    font-weight: 650;
  }
  .home-hero-name-divider {
    display: inline-block;
    width: 1.25rem;
    height: 1px;
    background: var(--color-accent);
  }

  .home-hero-title-mask {
    display: block;
    overflow: hidden;
    padding-right: 0.04em;
    padding-bottom: 0.05em;
    margin-bottom: -0.05em;
  }

  .home-hero-title-line {
    display: block;
    max-width: 100%;
    overflow-wrap: normal;
  }
  .home-hero-title-line em {
    color: var(--color-accent);
    font-weight: 400;
    font-style: italic;
  }

  .home-hero-bottom-row {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-m) var(--space-xl);
    margin-top: clamp(var(--space-m), 3.8vh, var(--space-xl));
  }

  .home-hero-tagline {
    flex: 1 1 25rem;
    max-width: 39rem;
    min-width: 0;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--step-0);
    line-height: 1.7;
  }

  .home-hero-actions {
    display: flex;
    flex: 0 1 auto;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .home-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--control-size);
    padding: var(--space-2xs) var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-s);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--step--1);
    font-weight: 620;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .home-action--primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .home-action:hover {
    border-color: var(--color-accent);
  }
  .home-action--primary:hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-hover);
  }
  .home-action-icon {
    display: inline-block;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .home-action:hover .home-action-icon {
    transform: translate(2px, -2px);
  }

  .home-hero-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.055em;
  }
  .home-hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .home-hero-scroll:hover {
    color: var(--color-accent);
  }
  .home-hero-scroll-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    color: var(--color-accent);
    font-size: 1rem;
    line-height: 1;
  }
  .home-hero-footer-note {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-overline);
  }

  /* All entrance motion is declarative: server-rendered text remains readable
     without JavaScript, and nothing loops except the tiny scroll arrow. */
  @keyframes hero-type-up {
    from {
      opacity: 0;
      transform: translate3d(0, 112%, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
  @keyframes hero-fade-in {
    from {
      opacity: 0;
      transform: translate3d(0, 13px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }
  @keyframes hero-rule-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @keyframes hero-scroll-hint {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .home-hero-overline::after {
      animation: hero-rule-grow 1000ms var(--ease-out) both;
    }
    .home-hero-title-line {
      animation: hero-type-up 900ms var(--ease-out) both;
    }
    .home-hero-title-mask:nth-child(2) .home-hero-title-line {
      animation-delay: 150ms;
    }
    .home-hero-title-mask:nth-child(3) .home-hero-title-line {
      animation-delay: 295ms;
    }
    .home-hero-overline-index,
    .home-hero-overline-discipline,
    .home-hero-name,
    .home-hero-tagline,
    .home-hero-actions,
    .home-hero-footer {
      animation: hero-fade-in 680ms var(--ease-out) both;
    }
    .home-hero-overline-index {
      animation-delay: 40ms;
    }
    .home-hero-overline-discipline {
      animation-delay: 120ms;
    }
    .home-hero-name {
      animation-delay: 110ms;
    }
    .home-hero-tagline {
      animation-delay: 480ms;
    }
    .home-hero-actions {
      animation-delay: 575ms;
    }
    .home-hero-footer {
      animation-delay: 745ms;
    }
    .home-hero-scroll-icon {
      animation: hero-scroll-hint 2200ms ease-in-out 1500ms infinite;
    }
  }

  @media (max-width: 940px) {
    .home-hero-bottom-row {
      align-items: start;
    }
  }
  @media (max-width: 720px) {
    .home-hero-inner {
      padding: var(--space-s);
    }
    .home-hero-overline-discipline {
      display: none;
    }
    .home-hero-content {
      padding-block: var(--space-l) var(--space-xl);
    }
    .home-hero-title {
      /* The display step would overflow 18-character lines on phones. */
      font-size: clamp(2.5rem, 11.5vw, 4.75rem);
    }
    .home-hero-bottom-row {
      gap: var(--space-s);
      margin-top: var(--space-m);
    }
    .home-hero-tagline {
      flex-basis: 100%;
    }
    .home-hero-actions {
      width: 100%;
    }
    .home-hero-footer-note {
      display: none;
    }
  }
  @media (max-width: 380px) {
    .home-hero-actions {
      gap: var(--space-3xs);
    }
    .home-action {
      padding-inline: var(--space-xs);
    }
  }
</style>
