---
import Eyebrow from "../ui/Eyebrow.astro";
import ExperienceCard from "../experience/ExperienceCard.astro";
import { homepageExperiences } from "../../data/experiences.ts";
import { localizePath, type Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

interface Props {
  lang: Locale;
  /** Position of the section on the page, numbering its overline. */
  index: number;
}
const { lang, index } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="home-experience"
  id="career-highlights"
  aria-labelledby="home-experience-heading"
>
  <div class="home-experience-heading">
    <div>
      <Eyebrow class="home-experience-eyebrow" index={index}>
        {t("home.experience.eyebrow")}
      </Eyebrow>
      <h2 id="home-experience-heading">{t("home.experience.title")}</h2>
    </div>
    <p class="home-experience-intro">{t("home.experience.intro")}</p>
  </div>

  <ol class="home-experience-grid">
    {homepageExperiences.map((entry) => (
      <li class="home-experience-card">
        <ExperienceCard experience={entry} lang={lang} variant="compact" />
      </li>
    ))}
  </ol>

  <a class="home-experience-more" href={localizePath("/experiences", lang)}>
    {t("home.experience.more")} <span aria-hidden="true">→</span>
  </a>
</section>

<style>
  .home-experience {
    margin-block: var(--space-xl) var(--space-2xl);
    color: var(--color-text);
  }
  .home-experience-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    padding-bottom: var(--space-m);
    margin-bottom: var(--space-s);
    border-bottom: 1px solid var(--color-border);
  }
  .home-experience-heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }
  .home-experience-intro {
    flex: 0 1 28rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: var(--leading-body);
  }
  .home-experience-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-experience-card {
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    transition:
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .home-experience-card:hover {
    border-color: var(--color-accent);
  }
  /* Lift only for a pointer that hovers, with motion allowed. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .home-experience-card:hover {
      transform: translateY(var(--lift));
    }
  }
  .home-experience-more {
    display: inline-flex;
    gap: var(--space-3xs);
    align-items: center;
    margin-top: var(--space-m);
    color: var(--color-accent);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
  }
  .home-experience-more:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 680px) {
    .home-experience {
      margin-block: var(--space-l) var(--space-xl);
    }
    .home-experience-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
