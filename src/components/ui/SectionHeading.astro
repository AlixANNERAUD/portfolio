---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "./Eyebrow.astro";

/**
 * Section header: eyebrow, H2 and description, with an optional `icon` slot
 * (decorative, left of the text) and an optional `count` shown on the right
 * ("06 areas"), the single adornment pattern for counted sections.
 */
type Props = HTMLAttributes<"header"> & {
  eyebrow: string;
  /** Position of the section on the page, numbering the eyebrow. */
  index?: number;
  title: string;
  description: string;
  headingId: string;
  /** A count of the section's items, e.g. `{ value: 6, label: "areas" }`. */
  count?: { value: number; label: string };
};

const {
  eyebrow,
  index,
  title,
  description,
  headingId,
  count,
  class: className,
  ...rest
} = Astro.props;
const hasIcon = Astro.slots.has("icon");
const pad = (n: number) => String(n).padStart(2, "0");
---

<header
  class:list={[
    "editorial-section-heading",
    { "editorial-section-heading--icon": hasIcon },
    className,
  ]}
  {...rest}
>
  <div class="editorial-section-heading__main">
    {hasIcon && (
      <span class="editorial-section-heading__icon" aria-hidden="true">
        <slot name="icon" />
      </span>
    )}
    <div>
      <Eyebrow class="editorial-section-heading__eyebrow" index={index}>
        {eyebrow}
      </Eyebrow>
      <h2 id={headingId}>{title}</h2>
      <p class="editorial-section-heading__description">{description}</p>
    </div>
  </div>
  {count && (
    <p class="editorial-section-heading__count">
      <strong>{pad(count.value)}</strong>
      <span>{count.label}</span>
    </p>
  )}
</header>

<style>
  .editorial-section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }
  .editorial-section-heading--icon {
    padding-bottom: var(--space-m);
    margin-bottom: 0;
  }
  .editorial-section-heading__main {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);
    min-width: 0;
  }
  .editorial-section-heading__icon {
    display: flex;
    flex: 0 0 3.1rem;
    align-items: center;
    justify-content: center;
    width: 3.1rem;
    height: 3.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .editorial-section-heading__eyebrow {
    margin-bottom: var(--space-2xs);
  }
  .editorial-section-heading h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 400;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }
  .editorial-section-heading__description {
    margin: var(--space-2xs) 0 0;
    max-width: 38rem;
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: var(--leading-body);
  }
  .editorial-section-heading__count {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3xs);
    margin: 0;
    color: var(--color-text-muted);
  }
  .editorial-section-heading__count strong {
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 400;
    line-height: 1;
  }
  .editorial-section-heading__count span {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
  }
</style>
