---
import type { HTMLAttributes } from "astro/types";
import { ArrowRight } from "@lucide/astro";
import Eyebrow from "./Eyebrow.astro";
import type { Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

/** Closing call to action pointing to the next page to read. */
type Props = HTMLAttributes<"footer"> & {
  lang: Locale;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
};

const {
  lang,
  title,
  description,
  href,
  linkLabel,
  class: className,
  ...rest
} = Astro.props;
const t = useTranslations(lang);
---

<footer class:list={["editorial-next", className]} {...rest}>
  <div>
    <Eyebrow class="editorial-next__eyebrow">{t("next.eyebrow")}</Eyebrow>
    <h2>{title}</h2>
    <p class="editorial-next__description">{description}</p>
  </div>
  <a href={href}>
    {linkLabel}
    <ArrowRight size={19} aria-hidden="true" />
  </a>
</footer>

<style>
  .editorial-next {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid var(--color-border);
  }
  .editorial-next h2 {
    margin: 0 0 0.45rem;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    font-weight: 400;
  }
  .editorial-next__description {
    margin: 0;
    color: var(--color-text-muted);
  }
  .editorial-next a {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--color-accent);
    border-radius: 0.5rem;
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .editorial-next a svg {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .editorial-next a:hover svg {
      transform: translateX(var(--nudge-x));
    }
  }
  @media (max-width: 680px) {
    .editorial-next {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
