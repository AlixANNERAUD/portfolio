---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"ul"> & {
  tags: readonly string[];
  /** Accessible name of the list (e.g. "Technologies used"). */
  label: string;
  density?: "project" | "timeline" | "skill";
};

const {
  tags,
  label,
  density = "project",
  class: className,
  ...rest
} = Astro.props;
---

<ul
  class:list={["editorial-tags", `editorial-tags--${density}`, className]}
  aria-label={label}
  {...rest}
>
  {tags.map((tag) => (
    <li>{tag}</li>
  ))}
</ul>

<style>
  .editorial-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }
  .editorial-tags li {
    background: var(--color-surface);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .editorial-tags--project {
    gap: 0.45rem;
    margin: 0 0 1.2rem;
  }
  .editorial-tags--project li {
    padding: 0.22rem 0.52rem;
    border-radius: 0.3rem;
    font-size: 0.72rem;
  }
  .editorial-tags--timeline {
    margin: 1rem 0 0;
  }
  .editorial-tags--timeline li {
    padding: 0.28rem 0.52rem;
    border-radius: 0.35rem;
    font-size: 0.71rem;
  }
  .editorial-tags--skill {
    margin: 0 0 1.45rem;
  }
  .editorial-tags--skill li {
    padding: 0.32rem 0.56rem;
    border-radius: 0.38rem;
    font-size: 0.76rem;
    line-height: 1.35;
  }
</style>
