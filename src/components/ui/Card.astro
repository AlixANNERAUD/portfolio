---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"article"> & {
  as?: "article" | "div" | "li";
  variant?: "project" | "timeline" | "skill";
  highlighted?: boolean;
};

const {
  as: Tag = "article",
  variant = "project",
  highlighted = false,
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  class:list={[
    "editorial-card",
    `editorial-card--${variant}`,
    { "editorial-card--highlighted": highlighted },
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .editorial-card {
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-bg);
    transition:
      border-color var(--dur-base) var(--ease-out),
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .editorial-card:hover {
    border-color: var(--color-border-strong);
  }
  .editorial-card--project {
    position: relative;
    overflow: hidden;
  }
  /* Only clickable cards lift, and only for a pointer with motion allowed. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .editorial-card--project:hover {
      transform: translateY(var(--lift));
    }
  }
  .editorial-card--timeline {
    margin: 0 0 1.25rem;
    padding: clamp(1.1rem, 2.5vw, 1.85rem);
  }
  .editorial-card--skill {
    display: flex;
    flex-direction: column;
    padding: clamp(1.3rem, 2.5vw, 1.9rem);
  }
  .editorial-card--highlighted {
    border-color: color-mix(
      in srgb,
      var(--color-accent) 45%,
      var(--color-border)
    );
    background: color-mix(
      in srgb,
      var(--color-accent-soft) 22%,
      var(--color-bg)
    );
  }
  @media (max-width: 680px) {
    .editorial-card--timeline {
      padding: 1rem;
    }
  }
  @media (max-width: 560px) {
    .editorial-card--skill {
      padding: 1.15rem;
    }
  }
</style>
