---
import type { HTMLAttributes } from "astro/types";

/** Small uppercase overline above a heading. */
type Props = HTMLAttributes<"p"> & {
  as?: "p" | "span";
};

const { as: Tag = "p", class: className, ...rest } = Astro.props;
---

<Tag class:list={["eyebrow", className]} {...rest}>
  <slot />
</Tag>

<style>
  /* Low specificity so callers can adjust spacing with their own class. */
  :where(.eyebrow) {
    margin: 0 0 var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
  }
</style>
