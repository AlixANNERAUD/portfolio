---
import { Moon, Sun } from "@lucide/astro";
import type { Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

export interface Props {
  lang: Locale;
}
const t = useTranslations(Astro.props.lang);
---

<!--
  "Dark theme" toggle button: pressed in dark theme. It stays hidden until
  its script runs, since it cannot work without JavaScript. With no stored
  choice the theme follows the system preference, live.
-->
<button
  class="site-theme-button site-control"
  type="button"
  data-theme-toggle
  aria-pressed="false"
>
  <span class="theme-icon theme-icon-moon" aria-hidden="true">
    <Moon size={18} />
  </span>
  <span class="theme-icon theme-icon-sun" aria-hidden="true">
    <Sun size={18} />
  </span>
  <span class="visually-hidden">{t("theme.toggle")}</span>
</button>
<script is:inline>
  {
    const button = document.querySelector("[data-theme-toggle]");
    if (button) {
      const root = document.documentElement;
      const key = "portfolio-theme";
      const system = matchMedia("(prefers-color-scheme: dark)");
      const metas = [...document.querySelectorAll('meta[name="theme-color"]')];
      const colors = Object.fromEntries(
        metas.map((meta) => [
          meta.media.includes("dark") ? "dark" : "light",
          meta.content,
        ]),
      );
      const stored = () => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      };
      const apply = (dark) => {
        root.classList.toggle("dark", dark);
        button.setAttribute("aria-pressed", String(dark));
        // Browser chrome follows the page theme, not only the system one.
        const color = colors[dark ? "dark" : "light"];
        if (color) for (const meta of metas) meta.content = color;
      };
      apply(root.classList.contains("dark"));
      button.dataset.ready = "";
      button.addEventListener("click", () => {
        const dark = !root.classList.contains("dark");
        apply(dark);
        try {
          localStorage.setItem(key, dark ? "dark" : "light");
        } catch {}
      });
      system.addEventListener("change", (event) => {
        const choice = stored();
        if (choice !== "dark" && choice !== "light") apply(event.matches);
      });
    }
  }
</script>

<style>
  .site-theme-button.site-control:not([data-ready]) {
    display: none;
  }

  .theme-icon {
    display: inline-flex;
  }

  .site-theme-button[aria-pressed="true"] .theme-icon-moon,
  .site-theme-button[aria-pressed="false"] .theme-icon-sun {
    display: none;
  }
</style>
