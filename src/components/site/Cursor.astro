---
/**
 * Hover highlight, after the iPadOS pointer: when a mouse rests on a link or
 * a button, a rounded translucent highlight takes the shape of the target
 * (padding, corner radius, a slight parallax toward the pointer), then fades
 * out when the pointer leaves. Large targets (project cards, which have their
 * own hover) get nothing. The system pointer always stays visible.
 *
 * Progressive enhancement only: it runs for a fine hovering mouse, never
 * under reduced motion, forced colors or a high-contrast preference, and
 * creates its element only on first use. A small requestAnimationFrame loop
 * eases the shape and stops once it settles.
 */
---

<script>
  const queries = {
    fine: window.matchMedia("(hover: hover) and (pointer: fine)"),
    reduce: window.matchMedia("(prefers-reduced-motion: reduce)"),
    forced: window.matchMedia("(forced-colors: active)"),
    contrast: window.matchMedia("(prefers-contrast: more)"),
  };
  const allowed = () =>
    queries.fine.matches &&
    !queries.reduce.matches &&
    !queries.forced.matches &&
    !queries.contrast.matches;

  // Targets up to this size get the highlight; larger ones get nothing.
  const MAX_W = 480;
  const MAX_H = 96;
  const PAD_X = 8;
  const PAD_Y = 4;
  // Share of the pointer offset from the target's center that the
  // highlight follows.
  const PARALLAX = 0.12;
  // Easing time constant: about 95% of the way in three of them.
  const TAU = 70;
  const interactive = "a, button, summary, [role='button'], label[for]";

  let enabled = allowed();
  let highlight: HTMLElement | null = null;
  let pointerX = 0;
  let pointerY = 0;
  // The mouse is over this document (not outside the window or in an iframe).
  let hasPointer = false;
  let target: HTMLElement | null = null;
  let snapped = false;
  // The target's own corner radius, read once per target: a length in px, or
  // a share of its short side for a percentage.
  let ownRadius = 0;
  let radiusIsShare = false;

  type Shape = {
    x: number;
    y: number;
    w: number;
    h: number;
    r: number;
    o: number;
  };
  const keys = ["x", "y", "w", "h", "r", "o"] as const;
  const current: Shape = { x: 0, y: 0, w: 0, h: 0, r: 0, o: 0 };
  const goal: Shape = { x: 0, y: 0, w: 0, h: 0, r: 0, o: 0 };

  const ensureHighlight = () => {
    if (!highlight) {
      highlight = document.createElement("div");
      highlight.className = "site-cursor-highlight";
      highlight.setAttribute("aria-hidden", "true");
      document.body.append(highlight);
    }
    return highlight;
  };

  const render = () => {
    if (!highlight) return;
    const { x, y, w, h, r, o } = current;
    highlight.style.transform = `translate(${x - w / 2}px, ${y - h / 2}px)`;
    highlight.style.width = `${w}px`;
    highlight.style.height = `${h}px`;
    highlight.style.borderRadius = `${r}px`;
    highlight.style.opacity = String(o);
  };

  /** The element under the pointer that can take the highlight, if any. */
  const hitTest = () =>
    document
      .elementFromPoint(pointerX, pointerY)
      ?.closest<HTMLElement>(interactive) ?? null;

  /**
   * Aim the goal at the target's current box. False when the target has
   * been removed or hidden (a theme menu item after a choice, for instance).
   */
  const measure = () => {
    if (!target?.isConnected) return false;
    const box = target.getBoundingClientRect();
    if (box.width === 0 && box.height === 0) return false;
    const centerX = box.left + box.width / 2;
    const centerY = box.top + box.height / 2;
    goal.x = centerX + (pointerX - centerX) * PARALLAX;
    goal.y = centerY + (pointerY - centerY) * PARALLAX;
    goal.w = box.width + 2 * PAD_X;
    goal.h = box.height + 2 * PAD_Y;
    const own = radiusIsShare
      ? ownRadius * Math.min(box.width, box.height)
      : ownRadius;
    // A pill (999px) stays a pill: never more than half the short side.
    goal.r = Math.min(own + PAD_Y, Math.min(goal.w, goal.h) / 2);
    return true;
  };

  let frame = 0;
  let last = 0;
  const tick = (now: number) => {
    frame = 0;
    // While snapped, follow the target every frame: it may drift, scale on
    // hover or be pushed away (homepage orbit tiles).
    if (snapped && !measure()) {
      const next = hitTest();
      setTarget(next === target ? null : next);
    }
    const dt = last ? Math.min(now - last, 64) : 16;
    last = now;
    const k = 1 - Math.exp(-dt / TAU);
    let moving = false;
    let changed = false;
    for (const key of keys) {
      const gap = goal[key] - current[key];
      if (gap === 0) continue;
      changed = true;
      const settled = Math.abs(gap) < (key === "o" ? 0.004 : 0.1);
      current[key] = settled ? goal[key] : current[key] + gap * k;
      if (!settled) moving = true;
    }
    if (changed) render();
    if (moving || snapped) frame = requestAnimationFrame(tick);
    else last = 0;
  };
  const wake = () => {
    if (!frame) frame = requestAnimationFrame(tick);
  };

  function setTarget(element: HTMLElement | null) {
    if (element !== target && element) {
      const value = getComputedStyle(element).borderTopLeftRadius;
      radiusIsShare = value.endsWith("%");
      ownRadius = radiusIsShare
        ? parseFloat(value) / 100
        : parseFloat(value) || 6;
    }
    target = element;
    const wasSnapped = snapped;
    snapped = false;
    if (element) {
      const box = element.getBoundingClientRect();
      // A link stretched over a card by a pseudo-element is hovered outside
      // its own box: highlighting it would jump away from the pointer.
      const inside =
        pointerX >= box.left - 4 &&
        pointerX <= box.right + 4 &&
        pointerY >= box.top - 4 &&
        pointerY <= box.bottom + 4;
      snapped =
        inside && box.width <= MAX_W && box.height <= MAX_H && measure();
    }
    if (snapped) {
      ensureHighlight();
      // Appearing: grow out of the target's own box instead of gliding in
      // from wherever the last highlight faded.
      if (current.o < 0.05) {
        Object.assign(current, goal, {
          w: goal.w - 2 * PAD_X,
          h: goal.h - 2 * PAD_Y,
          o: 0,
        });
      }
      goal.o = 1;
    } else {
      goal.o = 0;
    }
    if (snapped || wasSnapped) wake();
  }

  /** Hide at once and forget the target (disabled, or back from bfcache). */
  const reset = () => {
    if (frame) cancelAnimationFrame(frame);
    frame = 0;
    last = 0;
    target = null;
    snapped = false;
    hasPointer = false;
    current.o = goal.o = 0;
    render();
  };

  const sync = () => {
    enabled = allowed();
    if (!enabled) reset();
  };
  for (const query of Object.values(queries)) {
    query.addEventListener("change", sync);
  }

  document.addEventListener("pointerover", (event) => {
    if (!enabled) return;
    // Pen and touch keep the system behaviour, with no highlight.
    if (event.pointerType !== "mouse") {
      setTarget(null);
      return;
    }
    // pointerover fires before pointermove: take the position from it.
    pointerX = event.clientX;
    pointerY = event.clientY;
    hasPointer = true;
    // An iframe is not interactive here: entering one hides the highlight.
    setTarget((event.target as Element).closest<HTMLElement>(interactive));
  });
  window.addEventListener(
    "pointermove",
    (event) => {
      if (!enabled || event.pointerType !== "mouse") return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      hasPointer = true;
    },
    { passive: true },
  );
  document.addEventListener("pointerdown", (event) => {
    if (enabled && event.pointerType !== "mouse") setTarget(null);
  });
  // Leaving the window, or entering a frame that takes the events.
  document.addEventListener("pointerout", (event) => {
    if (!enabled || event.relatedTarget) return;
    hasPointer = false;
    setTarget(null);
  });
  // The page moves under a still pointer: follow the target, or drop it.
  window.addEventListener(
    "scroll",
    () => {
      if (!enabled || !hasPointer) return;
      const next = hitTest();
      if (next !== target) setTarget(next);
    },
    { passive: true },
  );

  // Each page is a new document: after a click that navigates, keep the
  // highlight on whatever sits under the pointer instead of waiting for the
  // next mouse move.
  const STORE = "cursor-position";
  const MAX_AGE = 5000;
  if (enabled) {
    try {
      const saved = JSON.parse(sessionStorage.getItem(STORE) ?? "null");
      if (saved && Date.now() - saved.at < MAX_AGE) {
        pointerX = saved.x;
        pointerY = saved.y;
        hasPointer = true;
        setTarget(hitTest());
      }
    } catch {
      // Storage unavailable: the highlight waits for the next mouse move.
    }
  }
  window.addEventListener("pagehide", () => {
    if (!enabled || !hasPointer) return;
    try {
      sessionStorage.setItem(
        STORE,
        JSON.stringify({ x: pointerX, y: pointerY, at: Date.now() }),
      );
    } catch {
      // Ignore: same fallback as above.
    }
  });
  // Back from the back-forward cache: the pointer may be anywhere.
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) return;
    reset();
    sync();
  });
</script>

<style is:global>
  /*
   * Created by the script on first use, so global. A faint fill keeps the
   * target's text legible; two hairlines, one in the text color and one in
   * the page color, keep the outline visible on the page and on the dark
   * category panels in both themes.
   */
  .site-cursor-highlight {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 2147483647;
    box-sizing: border-box;
    border: 1px solid color-mix(in oklch, var(--color-text) 45%, transparent);
    background: color-mix(in oklch, var(--color-text) 8%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--color-bg) 60%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce),
    (forced-colors: active),
    (prefers-contrast: more) {
    .site-cursor-highlight {
      display: none;
    }
  }
</style>
