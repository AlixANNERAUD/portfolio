---
import { site } from "../../data/site.ts";
import { localizePath, type Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

export interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner container">
    <p class="site-footer-credits">
      <span class="site-footer-name">
        © {year} {site.name}
      </span>
      <a href={site.source} target="_blank" rel="noopener noreferrer">
        {t("footer.source")}
        <span class="site-footer-external" aria-hidden="true">
          ↗
        </span>
        <span class="visually-hidden"> {t("a11y.newTab")}</span>
      </a>
      <span>{t("footer.builtWith")}</span>
    </p>
    <nav class="site-footer-nav" aria-label={t("footer.nav")}>
      <ul>
        <li>
          <a href={localizePath("/legal-notice", lang)}>
            {t("footer.legalNotice")}
          </a>
        </li>
        {site.profiles.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span class="site-footer-external" aria-hidden="true">
                ↗
              </span>
              <span class="visually-hidden"> {t("a11y.newTab")}</span>
            </a>
          </li>
        ))}
        <li>
          <a href={`mailto:${site.email}`}>{t("footer.email")}</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-subtle);
    font-size: var(--step--1);
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-l);
    padding-block: var(--space-m);
  }

  .site-footer-credits {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
  }

  /* Middle-dot separators between credits. */
  .site-footer-credits > * + *::before {
    content: "·";
    margin-inline: var(--space-2xs);
    color: var(--color-border-strong);
  }

  .site-footer-name {
    color: var(--color-text-muted);
  }

  .site-footer-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .site-footer a:hover {
    color: var(--color-accent);
  }

  .site-footer-external {
    margin-left: 0.2em;
    font-size: 0.85em;
  }

  /*
   * Narrow screens: two deliberate groups. The credits wrap as one line of
   * smaller text whose separators never start a line (the negative margin
   * pushes a line-leading separator into the clipped strip); the links form
   * an evenly spaced two-column grid.
   */
  @media (max-width: 720px) {
    .site-footer-inner {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-xs);
      padding-block: var(--space-s) var(--space-m);
    }

    .site-footer-credits {
      --separator: var(--space-s);
      margin-left: calc(-1 * var(--separator));
      clip-path: inset(0 0 0 var(--separator));
      font-size: var(--step--2);
    }

    .site-footer-credits > *::before,
    .site-footer-credits > * + *::before {
      content: "·";
      display: inline-block;
      width: var(--separator);
      margin: 0;
      color: var(--color-border-strong);
      text-align: center;
    }

    .site-footer-nav ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 var(--space-s);
    }
  }
</style>
