---
import ThemeToggle from "./ThemeToggle.astro";
import { localizePath, locales, type Locale } from "../../i18n/locales.ts";
import { useTranslations, type UIKey } from "../../i18n/ui.ts";

export interface Props {
  lang: Locale;
  /** English path of the current page. */
  path: string;
}
const { lang, path } = Astro.props;
const t = useTranslations(lang);
const other = locales.find((locale) => locale !== lang)!;
const tOther = useTranslations(other);
const current = localizePath(path, lang);
const links: { key: UIKey; path: string }[] = [
  { key: "nav.experiences", path: "/experiences" },
  { key: "nav.projects", path: "/projects" },
  { key: "nav.skills", path: "/skills" },
  { key: "nav.resume", path: "/resume" },
];
---

<header class="site-header">
  <div class="site-header-inner">
    <a
      class="site-brand"
      href={localizePath("/", lang)}
      aria-label={t("nav.home")}
    >
      Alix ANNERAUD
    </a>
    <nav class="site-main-nav" aria-label={t("nav.main")}>
      {links.map((link) => {
        const href = localizePath(link.path, lang);
        return (
          <a
            href={href}
            aria-current={
              current === href || current.startsWith(href + "/")
                ? "page"
                : undefined
            }
          >
            {t(link.key)}
          </a>
        );
      })}
    </nav>
    <div class="site-header-tools">
      <a
        class="site-locale"
        href={localizePath(path, other)}
        lang={other}
        aria-label={tOther("locale.switchTo")}
      >
        {tOther("locale.short")}
      </a>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>
