---
import { serializeGraph, type JsonLdNode } from "../../lib/seo.ts";

export interface Props {
  /** Nodes of the page's single schema.org `@graph`. */
  nodes: readonly JsonLdNode[];
}
const { nodes } = Astro.props;
---

{nodes.length > 0 && (
  <script type="application/ld+json" set:html={serializeGraph(nodes)} />
)}
