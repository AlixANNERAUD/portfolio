---
import {
  ArrowRight,
  ArrowUpRight,
  Bot,
  CodeXml,
  Cpu,
  Database,
  Server,
  Shield,
} from "@lucide/astro";
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Tags from "../ui/Tags.astro";
import { experiences } from "../../data/experiences.ts";
import { getProject, projectUrl } from "../../data/projects.ts";
import {
  skillDomains,
  type SkillDomain,
  type SkillEvidence,
} from "../../data/skills.ts";
import { localize } from "../../data/types.ts";
import { localizePath, type Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

/**
 * Technical domains, each backed by links to the projects, roles and degrees
 * that show it. Every link is labelled with its kind.
 */
interface Props {
  lang: Locale;
  /** Position of the section on the page, numbering its overline. */
  index: number;
}

const { lang, index } = Astro.props;
const t = useTranslations(lang);
const domains = skillDomains;

const icons = {
  cpu: Cpu,
  database: Database,
  code: CodeXml,
  server: Server,
  shield: Shield,
  bot: Bot,
} satisfies Record<SkillDomain["icon"], unknown>;

function evidenceLink(evidence: SkillEvidence) {
  if (evidence.kind === "project") {
    return {
      kind: t("skills.evidence.project"),
      title: localize(getProject(evidence.projectId).title, lang),
      href: projectUrl(evidence.projectId, lang),
      external: false,
    };
  }
  if (evidence.kind === "experience") {
    const entry = experiences.find(({ id }) => id === evidence.experienceId);
    if (!entry) throw new Error(`Unknown experience ${evidence.experienceId}`);
    return {
      kind: t(`skills.evidence.${entry.group}`),
      title: localize(entry.company, lang),
      // The card's heading on the timeline, never a collapsed earlier card.
      href: `${localizePath("/experiences", lang)}#${entry.id}-title`,
      external: false,
    };
  }
  const external = /^https?:\/\//.test(evidence.href);
  return {
    kind: t("skills.evidence.link"),
    title: evidence.label[lang],
    href: evidence.href.startsWith("/")
      ? localizePath(evidence.href, lang)
      : evidence.href,
    external,
  };
}
const pad = (n: number) => String(n).padStart(2, "0");
---

<section
  id="domains"
  class="skills-section"
  aria-labelledby="skills-domains-heading"
>
  <SectionHeading
    headingId="skills-domains-heading"
    eyebrow={t("skills.domains.eyebrow")}
    index={index}
    title={t("skills.domains.title")}
    description={t("skills.domains.intro")}
    count={{ value: domains.length, label: t("skills.domains.count") }}
  />

  <div class="skills-domain-grid">
    {domains.map((domain, index) => {
      const Icon = icons[domain.icon];
      return (
        <Card
          id={`skill-${domain.id}`}
          class="skills-domain-card"
          variant="skill"
          aria-labelledby={`skill-title-${domain.id}`}
        >
          <div class="skills-card-top">
            <span class="skills-domain-icon" aria-hidden="true">
              <Icon size={23} stroke-width={1.75} />
            </span>
            <span class="skills-card-index" aria-hidden="true">
              {pad(index + 1)}
            </span>
          </div>

          <h3 id={`skill-title-${domain.id}`}>{domain.title[lang]}</h3>
          <p class="skills-domain-description">{domain.description[lang]}</p>

          <Tags
            tags={domain.technologies.map((tag) => localize(tag, lang))}
            label={t("skills.technologies")}
            density="skill"
          />

          <div class="skills-evidence">
            <h4>{t("skills.evidence.label")}</h4>
            <ul>
              {domain.examples.map((evidence) => {
                const link = evidenceLink(evidence);
                return (
                  <li>
                    <span class="skills-evidence-kind">{link.kind}</span>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noopener noreferrer" : undefined}
                    >
                      <span class="skills-evidence-name">{link.title}</span>
                      {link.external ? (
                        <>
                          <ArrowUpRight size={16} aria-hidden="true" />
                          <span class="visually-hidden">
                            {" "}
                            {t("a11y.newTab")}
                          </span>
                        </>
                      ) : (
                        <ArrowRight size={16} aria-hidden="true" />
                      )}
                    </a>
                    <p>{evidence.detail[lang]}</p>
                  </li>
                );
              })}
            </ul>
          </div>
        </Card>
      );
    })}
  </div>
</section>

<style>
  .skills-section {
    margin-bottom: var(--space-2xl);
  }
  .skills-domain-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
  }
  .skills-card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-s);
  }
  .skills-domain-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .skills-card-index {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }
  /* Card titles share the serif display face with the project cards. */
  .skills-domain-card h3 {
    margin: 0 0 var(--space-2xs);
    border: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }
  .skills-domain-description {
    margin: 0 0 var(--space-s);
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: var(--leading-body);
  }
  .skills-evidence {
    margin-top: auto;
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
  }
  .skills-evidence h4 {
    margin: 0 0 var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
  }
  .skills-evidence ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 175px), 1fr));
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skills-evidence li {
    min-width: 0;
  }
  .skills-evidence-kind {
    display: block;
    margin-bottom: var(--space-3xs);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
  }
  /* Inline, so the arrow follows the last word even when the title wraps. */
  .skills-evidence a {
    color: var(--color-text);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }
  .skills-evidence a:hover {
    color: var(--color-accent);
  }
  .skills-evidence a svg {
    margin-left: var(--space-3xs);
    color: var(--color-accent);
    vertical-align: -0.15em;
  }
  .skills-evidence p {
    margin: var(--space-3xs) 0 0;
    color: var(--color-text-muted);
    font-size: var(--step--2);
    line-height: var(--leading-body);
  }
  @media (max-width: 720px) {
    .skills-domain-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
