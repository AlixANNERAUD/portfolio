---
import SectionHeading from "../ui/SectionHeading.astro";
import { spokenLanguages } from "../../data/skills.ts";
import type { Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

/** Spoken languages and their proficiency. */
interface Props {
  lang: Locale;
  /** Position of the section on the page, numbering its overline. */
  index: number;
}

const { lang, index } = Astro.props;
const t = useTranslations(lang);
const languages = spokenLanguages;
---

<section
  id="languages"
  class="skills-languages"
  aria-labelledby="skills-languages-heading"
>
  <SectionHeading
    headingId="skills-languages-heading"
    eyebrow={t("skills.languages.eyebrow")}
    index={index}
    title={t("skills.languages.title")}
    description={t("skills.languages.intro")}
    count={{ value: languages.length, label: t("skills.languages.count") }}
  />

  <ul class="skills-language-grid">
    {languages.map((language) => (
      <li>
        <strong>{language.name[lang]}</strong>
        <span class="skills-language-proficiency">
          {language.proficiency[lang]}
        </span>
        {language.detail && (
          <span class="skills-language-detail">{language.detail[lang]}</span>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .skills-languages {
    margin-bottom: var(--space-2xl);
  }
  .skills-language-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .skills-language-grid li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-width: 0;
    min-height: 8rem;
    padding: var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
  }
  .skills-language-grid strong {
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
  }
  .skills-language-proficiency {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
  .skills-language-detail {
    margin-top: auto;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: var(--tracking-mono);
  }
  @media (max-width: 720px) {
    .skills-language-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .skills-language-grid li {
      padding: var(--space-s);
    }
  }
</style>
