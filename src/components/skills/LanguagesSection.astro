---
import { Languages } from "@lucide/astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { spokenLanguages, type SpokenLanguage } from "../../data/skills.ts";
import type { Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

/** Spoken languages and their proficiency. */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const languages: readonly SpokenLanguage[] = spokenLanguages;
---

<section
  id="languages"
  class="skills-languages"
  aria-labelledby="skills-languages-heading"
>
  <SectionHeading
    headingId="skills-languages-heading"
    eyebrow={t("skills.languages.eyebrow")}
    title={t("skills.languages.title")}
    description={t("skills.languages.intro")}
  >
    <span slot="aside" class="skills-language-icon" aria-hidden="true">
      <Languages size={26} stroke-width={1.75} />
    </span>
  </SectionHeading>

  <ul class="skills-language-grid">
    {languages.map((language) => (
      <li>
        <strong>{language.name[lang]}</strong>
        <span>{language.proficiency[lang]}</span>
        {language.detail && (
          <span class="skills-language-detail">{language.detail[lang]}</span>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .skills-languages {
    margin-bottom: 4rem;
  }
  .skills-language-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-accent);
  }
  .skills-language-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .skills-language-grid li {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
    min-height: 8rem;
    padding: 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
  }
  .skills-language-grid strong {
    color: var(--color-text);
    font-size: 1.03rem;
  }
  .skills-language-grid li > span {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .skills-language-grid .skills-language-detail {
    margin-top: auto;
    color: var(--color-accent);
    font-size: 0.74rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }
  @media (max-width: 720px) {
    .skills-language-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .skills-language-grid li {
      padding: 1rem;
    }
    .skills-language-icon {
      display: none;
    }
  }
</style>
