---
import { localizePath, type Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";
import {
  EDGES,
  NODES,
  toPercent,
  type Point,
} from "../../lib/xila/topology.ts";

/**
 * Homepage deep dive into the Xila project architecture. The diagram shows
 * the layers of Xila only. A static SVG is always rendered; the WebGL canvas
 * replaces it once in view when WebGL2 is available and motion is allowed.
 */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const toSvg = ([x, y]: Point) => ({
  x: ((x + 1) / 2) * 1000,
  y: ((1 - y) / 2) * 400,
});
const svgNodes = NODES.map((node) => toSvg(node.position));
---

<section class="xila-topology" aria-label={t("xila.topology.title")}>
  <div class="xila-topology-heading">
    <div>
      <p class="xila-topology-kicker">{t("xila.topology.eyebrow")}</p>
      <h2>{t("xila.topology.title")}</h2>
    </div>
    <p class="xila-topology-intro">{t("xila.topology.intro")}</p>
  </div>

  <figure class="xila-topology-scene" data-xila-topology>
    <svg
      class="xila-topology-static"
      viewBox="0 0 1000 400"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="xila-topology-ink" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#47b9ab"></stop>
          <stop offset="1" stop-color="#8ecad9"></stop>
        </linearGradient>
      </defs>
      <g fill="none" stroke="#5faaa5" stroke-opacity=".68" stroke-width="2">
        {EDGES.map(([from, to]) => (
          <line
            x1={svgNodes[from].x}
            y1={svgNodes[from].y}
            x2={svgNodes[to].x}
            y2={svgNodes[to].y}
          />
        ))}
      </g>
      <g fill="url(#xila-topology-ink)" stroke="#152d32" stroke-width="5">
        {svgNodes.map(({ x, y }) => (
          <circle cx={x} cy={y} r="11" />
        ))}
      </g>
    </svg>

    <canvas class="xila-topology-canvas" aria-hidden="true"></canvas>

    <div class="xila-topology-labels" aria-hidden="true">
      {NODES.map((node) => {
        const { left, top } = toPercent(node.position);
        return (
          <span class="xila-node-label" style={`left: ${left}%; top: ${top}%`}>
            {t(node.label)}
          </span>
        );
      })}
    </div>
    <figcaption class="visually-hidden">
      {t("xila.topology.caption")}
    </figcaption>
  </figure>

  <a class="xila-topology-link" href={localizePath("/projects/xila", lang)}>
    {t("xila.topology.link")} <span aria-hidden="true">↗</span>
  </a>
</section>

<script>
  import type { TopologyRenderer } from "../../lib/xila/topology-webgl.ts";

  for (const scene of document.querySelectorAll<HTMLElement>(
    "[data-xila-topology]",
  )) {
    const canvas = scene.querySelector<HTMLCanvasElement>("canvas");
    const fallback = scene.querySelector<SVGElement>(".xila-topology-static");
    if (!canvas || !fallback) continue;

    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const compactLayout = matchMedia("(max-width: 720px)");
    let renderer: TopologyRenderer | null = null;
    let intersecting = false;
    let starting = false;

    const canAnimate = () =>
      !reducedMotion.matches &&
      !compactLayout.matches &&
      "WebGL2RenderingContext" in window &&
      "ResizeObserver" in window;

    const showCanvas = (visible: boolean) => {
      canvas.classList.toggle("is-ready", visible);
      fallback.style.display = visible ? "none" : "";
    };

    const teardown = () => {
      renderer?.dispose();
      renderer = null;
      showCanvas(false);
    };

    const activate = async () => {
      if (renderer) {
        renderer.start();
        return;
      }
      if (starting) return;
      starting = true;
      try {
        // The WebGL module is a separate chunk, fetched only when needed.
        const { createTopologyRenderer } =
          await import("../../lib/xila/topology-webgl.ts");
        if (!canAnimate() || !intersecting) return;
        renderer = createTopologyRenderer(canvas, teardown);
        if (renderer) {
          showCanvas(true);
          if (!document.hidden) renderer.start();
        }
      } catch {
        teardown();
      } finally {
        starting = false;
      }
    };

    const refresh = () => {
      if (!canAnimate()) {
        teardown();
      } else if (intersecting && !document.hidden) {
        void activate();
      } else {
        renderer?.stop();
      }
    };

    scene.addEventListener("pointermove", (event) => {
      if (!renderer || event.pointerType === "touch") return;
      const box = scene.getBoundingClientRect();
      if (!box.width || !box.height) return;
      renderer.setPointer(
        ((event.clientX - box.left) / box.width) * 2 - 1,
        1 - ((event.clientY - box.top) / box.height) * 2,
      );
    });
    scene.addEventListener("pointerleave", () => renderer?.setPointer(0, 0));
    reducedMotion.addEventListener("change", refresh);
    compactLayout.addEventListener("change", refresh);
    document.addEventListener("visibilitychange", refresh);

    // Without IntersectionObserver the static figure simply stays in place.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => {
          intersecting = entries.some((entry) => entry.isIntersecting);
          refresh();
        },
        { rootMargin: "200px" },
      ).observe(scene);
    }
  }
</script>

<style>
  .xila-topology {
    max-width: 1160px;
    margin: 3rem auto;
    padding: 0 1.5rem;
    color: var(--color-text);
  }
  .xila-topology-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: 1.75rem;
  }
  .xila-topology-heading > div {
    flex: 1 1 20rem;
  }
  .xila-topology-kicker {
    margin: 0 0 0.65rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-size: 0.74rem;
    letter-spacing: 0.15em;
    font-weight: 600;
  }
  .xila-topology-heading h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font: normal clamp(2rem, 3.6vw, 3.2rem) / 1.14 var(--font-display);
    letter-spacing: var(--tracking-display);
  }
  .xila-topology-intro {
    flex: 0 1 22rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.93rem;
    line-height: 1.65;
  }
  .xila-topology-scene {
    position: relative;
    height: clamp(280px, 37vw, 410px);
    margin: 0;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background:
      radial-gradient(ellipse at 50% 50%, #335f5733 0%, transparent 65%),
      linear-gradient(135deg, #0c1e25, #162c32 64%, #172c3b);
  }
  .xila-topology-scene::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(#ffffff0b 1px, transparent 1px),
      linear-gradient(90deg, #ffffff0b 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }
  .xila-topology-static,
  .xila-topology-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .xila-topology-canvas {
    opacity: 0;
  }
  .xila-topology-canvas.is-ready {
    opacity: 1;
  }
  .xila-topology-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .xila-node-label {
    position: absolute;
    transform: translate(-50%, 0.95rem);
    padding: 0.25rem 0.55rem;
    border: 1px solid #ffffff26;
    border-radius: 0.35rem;
    color: #f2f9f9;
    background: #10252cd9;
    font:
      600 clamp(0.67rem, 1.2vw, 0.83rem) / 1.3 ui-monospace,
      monospace;
    white-space: nowrap;
  }
  .xila-topology-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.25rem;
    color: var(--color-accent);
    font-size: 0.92rem;
    font-weight: 650;
    text-decoration: none;
  }
  .xila-topology-link:hover {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .xila-topology {
      margin: 2rem auto;
      padding: 0 1rem;
    }
    .xila-topology-scene {
      height: 310px;
    }
    .xila-topology-heading {
      align-items: start;
    }
    .xila-node-label {
      font-size: 0.65rem;
      padding: 0.2rem 0.35rem;
    }
  }
  @media (max-width: 420px) {
    .xila-topology-scene {
      height: 270px;
    }
    .xila-node-label {
      font-size: 0.58rem;
    }
  }
</style>
