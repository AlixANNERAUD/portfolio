---
import Eyebrow from "../ui/Eyebrow.astro";
import { localizePath, type Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";
import {
  EDGES,
  NODES,
  toPercent,
  type Point,
} from "../../lib/xila/topology.ts";

/**
 * Homepage deep dive into the Xila project architecture. The diagram shows
 * the layers of Xila only. A static SVG is always rendered; the WebGL canvas
 * replaces it once in view when WebGL2 is available and motion is allowed.
 */
interface Props {
  lang: Locale;
  /** Position of the section on the page, numbering its overline. */
  index: number;
}

const { lang, index } = Astro.props;
const t = useTranslations(lang);

const toSvg = ([x, y]: Point) => ({
  x: ((x + 1) / 2) * 1000,
  y: ((1 - y) / 2) * 400,
});
const svgNodes = NODES.map((node) => toSvg(node.position));
---

<section class="xila-topology" aria-label={t("xila.topology.title")}>
  <div class="xila-topology-heading">
    <div>
      <Eyebrow class="xila-topology-kicker" index={index}>
        {t("xila.topology.eyebrow")}
      </Eyebrow>
      <h2>{t("xila.topology.title")}</h2>
    </div>
    <p class="xila-topology-intro">{t("xila.topology.intro")}</p>
  </div>

  <figure class="xila-topology-scene" data-xila-topology>
    {/*
      Static fallback. The edges stretch with the box (strokes keep their
      width); the nodes are HTML dots placed by percentage, like the labels,
      so they stay round at every aspect ratio.
    */}
    <div class="xila-topology-static" aria-hidden="true">
      <svg viewBox="0 0 1000 400" preserveAspectRatio="none">
        <g class="xila-topology-edges">
          {EDGES.map(([from, to]) => (
            <line
              x1={svgNodes[from].x}
              y1={svgNodes[from].y}
              x2={svgNodes[to].x}
              y2={svgNodes[to].y}
              vector-effect="non-scaling-stroke"
            />
          ))}
        </g>
      </svg>
      {NODES.map((node) => {
        const { left, top } = toPercent(node.position);
        return (
          <span class="xila-node-dot" style={`left: ${left}%; top: ${top}%`} />
        );
      })}
    </div>

    <canvas class="xila-topology-canvas" aria-hidden="true"></canvas>

    <div class="xila-topology-labels" aria-hidden="true">
      {NODES.map((node) => {
        const { left, top } = toPercent(node.position);
        return (
          <span class="xila-node-label" style={`left: ${left}%; top: ${top}%`}>
            {t(node.label)}
          </span>
        );
      })}
    </div>
    <figcaption class="visually-hidden">
      {t("xila.topology.caption")}
    </figcaption>
  </figure>

  <a class="xila-topology-link" href={localizePath("/projects/xila", lang)}>
    {t("xila.topology.link")} <span aria-hidden="true">→</span>
  </a>
</section>

<script>
  import type { TopologyRenderer } from "../../lib/xila/topology-webgl.ts";

  for (const scene of document.querySelectorAll<HTMLElement>(
    "[data-xila-topology]",
  )) {
    const canvas = scene.querySelector<HTMLCanvasElement>("canvas");
    const fallback = scene.querySelector<HTMLElement>(".xila-topology-static");
    if (!canvas || !fallback) continue;

    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const compactLayout = matchMedia("(max-width: 720px)");
    let renderer: TopologyRenderer | null = null;
    let intersecting = false;
    let starting = false;

    const canAnimate = () =>
      !reducedMotion.matches &&
      !compactLayout.matches &&
      "WebGL2RenderingContext" in window &&
      "ResizeObserver" in window;

    const showCanvas = (visible: boolean) => {
      canvas.classList.toggle("is-ready", visible);
      fallback.style.display = visible ? "none" : "";
    };

    const teardown = () => {
      renderer?.dispose();
      renderer = null;
      showCanvas(false);
    };

    const activate = async () => {
      if (renderer) {
        renderer.start();
        return;
      }
      if (starting) return;
      starting = true;
      try {
        // The WebGL module is a separate chunk, fetched only when needed.
        const { createTopologyRenderer } =
          await import("../../lib/xila/topology-webgl.ts");
        if (!canAnimate() || !intersecting) return;
        renderer = createTopologyRenderer(canvas, teardown);
        if (renderer) {
          showCanvas(true);
          if (!document.hidden) renderer.start();
        }
      } catch {
        teardown();
      } finally {
        starting = false;
      }
    };

    const refresh = () => {
      if (!canAnimate()) {
        teardown();
      } else if (intersecting && !document.hidden) {
        void activate();
      } else {
        renderer?.stop();
      }
    };

    scene.addEventListener("pointermove", (event) => {
      if (!renderer || event.pointerType === "touch") return;
      const box = scene.getBoundingClientRect();
      if (!box.width || !box.height) return;
      renderer.setPointer(
        ((event.clientX - box.left) / box.width) * 2 - 1,
        1 - ((event.clientY - box.top) / box.height) * 2,
      );
    });
    scene.addEventListener("pointerleave", () => renderer?.setPointer(0, 0));
    reducedMotion.addEventListener("change", refresh);
    compactLayout.addEventListener("change", refresh);
    document.addEventListener("visibilitychange", refresh);

    // Without IntersectionObserver the static figure simply stays in place.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => {
          intersecting = entries.some((entry) => entry.isIntersecting);
          refresh();
        },
        { rootMargin: "200px" },
      ).observe(scene);
    }
  }
</script>

<style>
  /*
   * The scene is always dark (it mirrors the WebGL render), so its colours
   * are component-local tokens rather than theme tokens.
   */
  .xila-topology {
    --xila-ink: #47b9ab;
    --xila-ink-2: #8ecad9;
    --xila-edge: #5faaa5ad;
    --xila-node-ring: #152d32;
    --xila-scene-glow: #335f5733;
    --xila-scene-1: #0c1e25;
    --xila-scene-2: #162c32;
    --xila-scene-3: #172c3b;
    --xila-grid: #ffffff0b;
    --xila-label-bg: #10252cd9;
    --xila-label-border: #ffffff26;
    --xila-label-text: #f2f9f9;

    margin-block: var(--space-xl);
    color: var(--color-text);
  }
  .xila-topology-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
    margin-bottom: var(--space-m);
  }
  .xila-topology-heading > div {
    flex: 1 1 20rem;
  }
  .xila-topology-heading h2 {
    margin: 0;
    padding: 0;
    border: 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }
  .xila-topology-intro {
    flex: 0 1 22rem;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: var(--leading-body);
  }
  .xila-topology-scene {
    position: relative;
    height: clamp(280px, 37vw, 410px);
    margin: 0;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background:
      radial-gradient(
        ellipse at 50% 50%,
        var(--xila-scene-glow) 0%,
        transparent 65%
      ),
      linear-gradient(
        135deg,
        var(--xila-scene-1),
        var(--xila-scene-2) 64%,
        var(--xila-scene-3)
      );
  }
  .xila-topology-scene::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--xila-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--xila-grid) 1px, transparent 1px);
    background-size: 28px 28px;
    pointer-events: none;
  }
  .xila-topology-static,
  .xila-topology-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .xila-topology-static svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .xila-topology-edges {
    fill: none;
    stroke: var(--xila-edge);
    stroke-width: 2;
  }
  .xila-node-dot {
    position: absolute;
    width: 1.375rem;
    aspect-ratio: 1;
    border: 4px solid var(--xila-node-ring);
    border-radius: 50%;
    background: linear-gradient(135deg, var(--xila-ink), var(--xila-ink-2));
    transform: translate(-50%, -50%);
  }
  .xila-topology-canvas {
    opacity: 0;
  }
  .xila-topology-canvas.is-ready {
    opacity: 1;
  }
  .xila-topology-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .xila-node-label {
    position: absolute;
    transform: translate(-50%, var(--space-s));
    padding: var(--space-3xs) var(--space-2xs);
    border: 1px solid var(--xila-label-border);
    border-radius: var(--radius-s);
    color: var(--xila-label-text);
    background: var(--xila-label-bg);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    line-height: var(--leading-snug);
    white-space: nowrap;
  }
  .xila-topology-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-top: var(--space-m);
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }
  .xila-topology-link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  @media (max-width: 720px) {
    .xila-topology {
      margin-block: var(--space-l);
    }
    .xila-topology-scene {
      height: 310px;
    }
    .xila-topology-heading {
      align-items: start;
    }
    .xila-node-dot {
      width: 1.125rem;
      border-width: 3px;
    }
    .xila-node-label {
      padding: var(--space-3xs) var(--space-3xs);
    }
  }
  @media (max-width: 420px) {
    .xila-topology-scene {
      height: 270px;
    }
  }
</style>
