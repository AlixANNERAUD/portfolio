---
import type { Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

/**
 * Link to the hosted Xila WebAssembly demo, plus an opt-in embedded panel.
 * The iframe only receives its `src` once the visitor asks for it; without
 * JavaScript the button stays hidden and the external link still works.
 */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// The demo is published by Xila Platforms in each supported locale.
const DEMO_URL = `https://platforms.xila.dev/demonstrations/wasm/${lang}/`;
---

<section class="xila-demo" aria-label={t("xila.demo.title")}>
  <div class="xila-demo-heading">
    <div class="xila-demo-illustration" aria-hidden="true">
      <span class="xila-demo-mark">X</span>
      <span class="xila-demo-terminal">xila&gt; _</span>
    </div>
    <div>
      <h3>{t("xila.demo.title")}</h3>
      <p>{t("xila.demo.subtitle")}</p>
    </div>
  </div>

  <p class="xila-demo-warning">{t("xila.demo.warning")}</p>

  <div class="xila-demo-actions">
    <a
      href={DEMO_URL}
      class="xila-demo-primary button-link button-link--primary"
      target="_blank"
      rel="noopener noreferrer"
    >
      {t("xila.demo.external")}
      <span aria-hidden="true">↗</span>
    </a>
    <button
      type="button"
      class="xila-demo-toggle button-link"
      aria-expanded="false"
      aria-controls="xila-embedded-demo"
      data-label-open={t("xila.demo.start")}
      data-label-close={t("xila.demo.close")}
      hidden
    >
      {t("xila.demo.start")}
    </button>
  </div>
  <p class="xila-demo-privacy">{t("xila.demo.privacy")}</p>

  <div id="xila-embedded-demo" class="xila-demo-panel" hidden>
    {/* Filled after the panel is shown, so screen readers announce it. */}
    <p
      class="xila-demo-loading"
      role="status"
      data-message={t("xila.demo.loading")}
    ></p>
    <iframe
      data-src={DEMO_URL}
      title={t("xila.demo.frame")}
      referrerpolicy="no-referrer"
      allow="clipboard-read; clipboard-write"
      sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock allow-downloads"
    ></iframe>
    <p class="xila-demo-fallback">{t("xila.demo.fallback")}</p>
  </div>
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    ".xila-demo-toggle",
  )) {
    const panel = document.getElementById(
      button.getAttribute("aria-controls") ?? "",
    );
    const frame = panel?.querySelector("iframe");
    const loading = panel?.querySelector<HTMLElement>(".xila-demo-loading");
    if (!panel || !frame || !loading) continue;

    let loaded = false;
    frame.addEventListener("load", () => {
      if (!frame.hasAttribute("src")) return;
      loaded = true;
      loading.textContent = "";
    });

    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(open));
      button.textContent =
        (open ? button.dataset.labelClose : button.dataset.labelOpen) ?? "";
      panel.hidden = !open;
      loading.textContent = "";
      loaded = false;
      if (open) {
        requestAnimationFrame(() => {
          if (!loaded) loading.textContent = loading.dataset.message ?? "";
        });
      }
      // Closing unloads the demo; reopening starts it afresh.
      if (open) frame.src = frame.dataset.src ?? "";
      else frame.removeAttribute("src");
    });
    button.hidden = false;
  }
</script>

<style>
  .xila-demo {
    /* The illustration tile is always dark, like the Xila terminal. */
    --xila-tile-1: #162b35;
    --xila-tile-2: #284c53;
    --xila-tile-text: #ffffff;
    --xila-frame-bg: #101820;

    margin: var(--space-m) 0 var(--space-l);
    padding: var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-l);
    background: var(--color-surface);
  }
  .xila-demo-heading {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }
  .xila-demo-heading h3 {
    margin: 0 0 var(--space-3xs);
    border: 0;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
  }
  .xila-demo-heading p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
  /* Fixed size in both layouts: never stretched by the flex direction. */
  .xila-demo-illustration {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3xs);
    width: 6.5rem;
    aspect-ratio: 13 / 11;
    border-radius: var(--radius-m);
    background: linear-gradient(145deg, var(--xila-tile-1), var(--xila-tile-2));
    color: var(--xila-tile-text);
  }
  .xila-demo-mark {
    font-family: var(--font-display);
    font-size: var(--step-5);
    line-height: 1;
  }
  .xila-demo-terminal {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    opacity: 0.8;
    white-space: nowrap;
  }
  .xila-demo-warning {
    margin: var(--space-s) 0;
    color: var(--color-text-muted);
    font-size: var(--step--1);
    line-height: var(--leading-body);
  }
  .xila-demo-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs);
  }
  .xila-demo-actions > button[hidden],
  .xila-demo-panel[hidden],
  .xila-demo-loading:empty {
    display: none;
  }
  .xila-demo-privacy,
  .xila-demo-fallback {
    margin: var(--space-s) 0 0;
    color: var(--color-text-muted);
    font-size: var(--step--2);
    line-height: var(--leading-body);
  }
  .xila-demo-panel {
    margin-top: var(--space-s);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
  }
  .xila-demo-panel iframe {
    display: block;
    width: 100%;
    height: min(68vh, 620px);
    min-height: 360px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--xila-frame-bg);
  }
  .xila-demo-loading {
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
  @media (max-width: 600px) {
    .xila-demo-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-s);
    }
    .xila-demo-actions > a,
    .xila-demo-actions > button {
      width: 100%;
    }
    .xila-demo-panel iframe {
      min-height: 300px;
    }
  }
</style>
