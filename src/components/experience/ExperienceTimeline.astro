---
import { BriefcaseBusiness, ChevronDown, GraduationCap } from "@lucide/astro";
import ExperienceCard from "./ExperienceCard.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import type { Experience, ExperienceGroup } from "../../data/experiences.ts";
import type { Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";
import { formatCount } from "../../lib/format.ts";

/**
 * One group of the career page (professional or education): heading, recent
 * cards, then earlier cards behind a single toggle. Without JavaScript every
 * card stays visible and the toggle stays hidden; the script below collapses
 * the earlier list and reveals the toggle.
 */
interface Props {
  group: ExperienceGroup;
  /** Position of the section on the page, from 1. */
  index: number;
  entries: readonly Experience[];
  lang: Locale;
}

const { group, index, entries, lang } = Astro.props;
const t = useTranslations(lang);

const recent = entries.filter((entry) => !entry.earlier);
const earlier = entries.filter((entry) => entry.earlier);
// "3 earlier roles": the toggle says how many cards it reveals.
const earlierItems = formatCount(
  earlier.length,
  group === "professional" ? "earlierRole" : "earlierMilestone",
  lang,
);
const showLabel = t(`experiences.${group}.showEarlier`, {
  items: earlierItems,
});
const hideLabel = t(`experiences.${group}.hideEarlier`, {
  items: earlierItems,
});
const headingId = `${group}-heading`;
const earlierId = `earlier-${group}`;
const Icon = group === "professional" ? BriefcaseBusiness : GraduationCap;
---

<section id={group} class="career-group" aria-labelledby={headingId}>
  <SectionHeading
    headingId={headingId}
    eyebrow={t(`experiences.${group}.eyebrow`)}
    index={index}
    title={t(`experiences.${group}.title`)}
    description={t(`experiences.${group}.description`)}
  >
    <Fragment slot="icon">
      <Icon size={22} />
    </Fragment>
  </SectionHeading>

  <ol class="career-timeline">
    {recent.map((entry) => (
      <li class="career-timeline-item">
        <div class="career-timeline-rail" aria-hidden="true">
          <span class="career-timeline-dot" />
          <span class="career-timeline-date">{entry.period[lang]}</span>
        </div>
        <ExperienceCard experience={entry} lang={lang} />
      </li>
    ))}
  </ol>

  {earlier.length > 0 && (
    <>
      <button
        type="button"
        class="career-earlier-toggle"
        aria-expanded="false"
        aria-controls={earlierId}
        data-label-show={showLabel}
        data-label-hide={hideLabel}
        hidden
      >
        <span>{showLabel}</span>
        <ChevronDown size={17} aria-hidden="true" />
      </button>
      <ol id={earlierId} class="career-timeline career-timeline--earlier">
        {earlier.map((entry) => (
          <li class="career-timeline-item">
            <div class="career-timeline-rail" aria-hidden="true">
              <span class="career-timeline-dot" />
              <span class="career-timeline-date">{entry.period[lang]}</span>
            </div>
            <ExperienceCard experience={entry} lang={lang} />
          </li>
        ))}
      </ol>
    </>
  )}
</section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    ".career-earlier-toggle",
  )) {
    const list = document.getElementById(
      button.getAttribute("aria-controls") ?? "",
    );
    const label = button.querySelector("span");
    if (!list || !label) continue;

    const render = (expanded: boolean) => {
      button.setAttribute("aria-expanded", String(expanded));
      list.hidden = !expanded;
      const { labelShow, labelHide } = button.dataset;
      label.textContent = (expanded ? labelHide : labelShow) ?? "";
    };

    render(false);
    button.hidden = false;
    button.addEventListener("click", () =>
      render(button.getAttribute("aria-expanded") !== "true"),
    );
  }
</script>

<style>
  .career-group {
    margin: 0 0 var(--space-2xl);
  }
  .career-timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .career-timeline--earlier {
    margin-bottom: var(--space-3xs);
  }
  .career-timeline[hidden] {
    display: none;
  }
  .career-timeline-item {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-m);
  }
  .career-timeline-rail {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: var(--space-l) var(--space-m) 0 0;
    border-right: 1px solid var(--color-border);
  }
  .career-timeline-item:last-child .career-timeline-rail {
    border-right-color: transparent;
  }
  .career-timeline-dot {
    position: absolute;
    z-index: 1;
    /* Level with the first line of the date. */
    top: calc(var(--space-l) + 0.4rem);
    right: -0.34rem;
    width: 0.68rem;
    height: 0.68rem;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    background: var(--color-bg);
  }
  .career-timeline-date {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-body);
    text-align: right;
  }
  /*
   * The toggle reads as an editorial link on the rail (accent text, chevron,
   * underline on hover) rather than a grey box. It aligns with the cards.
   */
  .career-earlier-toggle {
    display: inline-flex;
    min-height: var(--control-size);
    align-items: center;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-m) calc(11rem + var(--space-m));
    padding: 0 var(--space-s);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-accent);
    font-size: var(--step--1);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .career-earlier-toggle[hidden] {
    display: none;
  }
  .career-earlier-toggle:hover {
    border-style: solid;
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }
  .career-earlier-toggle > span {
    min-width: 0;
    overflow-wrap: anywhere;
    text-align: left;
  }
  .career-earlier-toggle svg {
    flex: none;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .career-earlier-toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  @media (max-width: 680px) {
    .career-timeline-item {
      grid-template-columns: 1.1rem minmax(0, 1fr);
      gap: var(--space-2xs);
    }
    .career-timeline-rail {
      padding: 0;
      align-items: flex-end;
    }
    .career-timeline-date {
      display: none;
    }
    .career-timeline-dot {
      top: 1.4rem;
    }
    .career-earlier-toggle {
      max-width: calc(100% - 1.1rem - var(--space-2xs));
      margin-left: calc(1.1rem + var(--space-2xs));
    }
  }
</style>
