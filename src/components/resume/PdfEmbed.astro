---
import { FileText } from "@lucide/astro";

/**
 * Inline PDF preview for wide screens. Narrow screens hide it and rely on
 * the page's Download/Open buttons; browsers that cannot show the PDF render
 * the fallback paragraph and link instead.
 */
interface Props {
  src: string;
  title: string;
  fallback: string;
  /** A neutral label ("Open the PDF"); the hidden note adds "new tab". */
  openLabel: string;
  newTabLabel: string;
}

const { src, title, fallback, openLabel, newTabLabel } = Astro.props;
---

<object
  class="resume-preview"
  data={src}
  type="application/pdf"
  title={title}
  aria-label={title}
>
  <div class="resume-preview__fallback">
    <FileText size={32} stroke-width={1.5} aria-hidden="true" />
    <p>{fallback}</p>
    <a class="button-link" href={src} target="_blank" rel="noopener noreferrer">
      {openLabel}
      <span class="visually-hidden"> {newTabLabel}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</object>

<style>
  .resume-preview {
    display: none;
  }
  @media (min-width: 900px) {
    .resume-preview {
      position: sticky;
      top: calc(var(--header-h) + var(--space-s));
      display: block;
      width: 100%;
      height: calc(100dvh - var(--header-h) - 2 * var(--space-s));
      min-height: 37.5rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-l);
      background: var(--color-surface);
    }
  }
  /* Centred empty state when the browser cannot show the PDF inline. */
  .resume-preview__fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    height: 100%;
    padding: var(--space-l);
    color: var(--color-text-muted);
    text-align: center;
  }
  .resume-preview__fallback p {
    max-width: 28ch;
    margin: 0;
  }
  .resume-preview__fallback svg {
    color: var(--color-accent);
  }
</style>
