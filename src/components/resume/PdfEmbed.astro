---
/**
 * Inline PDF preview for wide screens. Narrow screens hide it and rely on
 * the page's Download/Open buttons; browsers that cannot show the PDF render
 * the fallback paragraph and link instead.
 */
interface Props {
  src: string;
  title: string;
  fallback: string;
  openLabel: string;
  newTabLabel: string;
}

const { src, title, fallback, openLabel, newTabLabel } = Astro.props;
---

<object
  class="resume-preview"
  data={src}
  type="application/pdf"
  title={title}
  aria-label={title}
>
  <p class="resume-preview__fallback">
    {fallback}{" "}
    <a href={src} target="_blank" rel="noopener noreferrer">
      {openLabel}
      <span class="visually-hidden"> {newTabLabel}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </p>
</object>

<style>
  .resume-preview {
    display: none;
  }
  @media (min-width: 900px) {
    .resume-preview {
      position: sticky;
      top: calc(var(--header-h) + var(--space-s));
      display: block;
      width: 100%;
      height: calc(100dvh - var(--header-h) - 2 * var(--space-s));
      min-height: 37.5rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-l);
      background: var(--color-surface);
    }
  }
  .resume-preview__fallback {
    margin: 0;
    padding: var(--space-m);
    color: var(--color-text-muted);
  }
</style>
