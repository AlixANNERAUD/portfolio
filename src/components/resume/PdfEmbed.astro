---
/** Full-height PDF viewer with a link opening the file in a new tab. */
interface Props {
  src: string;
  title: string;
  openLabel: string;
}

const { src, title, openLabel } = Astro.props;
---

<div class="pdf-container">
  <iframe
    src={src}
    title={title}
    width="100%"
    height="100%"
    style="border: none"
  ></iframe>
  <a class="pdf-open-link" href={src} target="_blank" rel="noopener noreferrer">
    {openLabel} ↗
  </a>
</div>

<style>
  .pdf-container {
    position: relative;
    width: 100%;
    height: 100vh;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }
  .pdf-open-link {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    z-index: 1;
    padding: 0.4rem 0.7rem;
    border-radius: 0.375rem;
    color: var(--vp-c-brand-1);
    background: var(--vp-c-bg-soft);
    font-size: 0.85rem;
  }
  iframe {
    display: block;
  }
</style>
