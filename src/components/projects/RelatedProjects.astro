---
import ProjectCard from "./ProjectCard.astro";
import type { CatalogueProject } from "../../data/projects.ts";
import type { Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";

/**
 * Related projects at the end of a project page, as catalogue index rows
 * (the list view of ProjectCard), under one H2.
 */
interface Props {
  projects: readonly CatalogueProject[];
  lang: Locale;
}

const { projects, lang } = Astro.props;
const t = useTranslations(lang);
---

{projects.length > 0 && (
  <section class="project-related" aria-labelledby="project-related-title">
    <h2 id="project-related-title">{t("project.related")}</h2>
    <p class="project-related__intro">{t("project.relatedIntro")}</p>
    <div class="project-related__list showcase-grid" data-view="list">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} headingLevel="h3" />
      ))}
    </div>
  </section>
)}

<style>
  .project-related {
    margin-top: var(--space-2xl);
    padding-top: var(--space-s);
    border-top: 1px solid var(--color-border);
  }
  h2 {
    margin: 0 0 var(--space-3xs);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-heading);
  }
  .project-related__intro {
    margin: 0 0 var(--space-m);
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
  .project-related__list {
    display: grid;
    gap: var(--space-s);
  }
</style>
