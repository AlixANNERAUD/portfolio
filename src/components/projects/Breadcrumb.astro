---
import type { HTMLAttributes } from "astro/types";
import { ChevronRight } from "@lucide/astro";

export interface Crumb {
  label: string;
  /** Omitted for the current page, which is the last crumb. */
  href?: string;
}

/** Breadcrumb trail: links to the parent pages, then the current page. */
type Props = HTMLAttributes<"nav"> & {
  items: readonly Crumb[];
  /** Accessible name of the landmark ("Breadcrumb"). */
  label: string;
};

const { items, label, class: className, ...rest } = Astro.props;
---

<nav class:list={["breadcrumb", className]} aria-label={label} {...rest}>
  <ol>
    {items.map((item, index) => (
      <li>
        {index > 0 && <ChevronRight size={14} aria-hidden="true" />}
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
    font-size: var(--step--1);
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    min-width: 0;
  }
  li svg {
    flex: none;
    color: var(--color-text-subtle);
  }
  a {
    display: inline-flex;
    min-height: var(--control-size);
    align-items: center;
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  [aria-current="page"] {
    overflow: hidden;
    color: var(--color-text);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
