---
import Hero from "../ui/Hero.astro";
import ProjectCard from "./ProjectCard.astro";
import {
  byScore,
  projects,
  type ProjectCategory,
} from "../../data/projects.ts";
import type { Locale } from "../../i18n/locales.ts";
import { useTranslations } from "../../i18n/ui.ts";
import { formatCount } from "../../lib/format.ts";

/**
 * Every project card is server-rendered in relevance order. One row of area
 * filters, revealed by a module script, toggles `hidden` on the cards;
 * without JavaScript the full list stays visible.
 */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const categoryOrder = [
  "systems",
  "software",
  "web",
  "infrastructure",
  "embedded",
  "security",
  "data",
] as const satisfies readonly ProjectCategory[];

const sorted = [...projects].sort(byScore);
// Only areas that hold a project get a filter, each with its count.
const filters = [
  { id: "all", label: t("projects.all"), count: sorted.length },
  ...categoryOrder
    .map((id) => ({
      id,
      label: t(`category.${id}`),
      count: sorted.filter((project) => project.category === id).length,
    }))
    .filter(({ count }) => count > 0),
];
---

<section
  class="portfolio-showcase portfolio-showcase--catalogue"
  aria-label={t("projects.label")}
  data-catalogue
  data-lang={lang}
>
  <Hero
    variant="compact"
    headingLevel="h1"
    eyebrow={t("projects.eyebrow")}
    title={t("nav.projects")}
    intro={t("projects.intro")}
  />

  <div
    class="showcase-filters"
    role="group"
    aria-label={t("projects.filter")}
    hidden
  >
    {filters.map(({ id, label, count }) => (
      <button
        type="button"
        value={id}
        aria-pressed={id === "all" ? "true" : "false"}
      >
        {label}
        <span class="showcase-filter-count">{count}</span>
      </button>
    ))}
  </div>

  <p
    class="visually-hidden"
    role="status"
    data-count-one={t("count.project.one")}
    data-count-other={t("count.project.other")}
  >
    {formatCount(sorted.length, "project", lang)}
  </p>

  <div class="showcase-grid" data-catalogue-grid data-view="list">
    {sorted.map((project) => (
      <ProjectCard
        project={project}
        lang={lang}
        headingLevel="h2"
        data-category={project.category}
      />
    ))}
  </div>
</section>

<script>
  import { formatPlural } from "../../lib/plural.ts";
  import type { Locale } from "../../i18n/locales.ts";

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-catalogue]",
  )) {
    const lang = root.dataset.lang as Locale | undefined;
    const bar = root.querySelector<HTMLElement>(".showcase-filters");
    const grid = root.querySelector<HTMLElement>("[data-catalogue-grid]");
    const status = root.querySelector<HTMLElement>("[role=status]");
    const { countOne, countOther } = status?.dataset ?? {};
    // Broken markup leaves the server-rendered list untouched.
    if (!lang || !countOne || !countOther || !bar || !grid || !status) continue;

    const cards = [...grid.querySelectorAll<HTMLElement>(".showcase-card")];
    const buttons = [...bar.querySelectorAll("button")];
    const forms = { one: countOne, other: countOther };

    for (const button of buttons) {
      button.addEventListener("click", () => {
        let shown = 0;
        for (const card of cards) {
          card.hidden =
            button.value !== "all" && card.dataset.category !== button.value;
          if (!card.hidden) shown++;
        }
        for (const other of buttons) {
          other.setAttribute("aria-pressed", String(other === button));
        }
        status.textContent = formatPlural(shown, forms, lang);
      });
    }
    bar.hidden = false;
  }
</script>

<style>
  .portfolio-showcase {
    margin-block: var(--space-xl) var(--space-2xl);
  }
  /*
   * One row of plain text filters, like a table of contents: the active area
   * is underlined in the accent colour, each one shows how many projects it
   * holds.
   */
  .showcase-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-m);
    margin: 0 0 var(--space-m);
  }
  /*
   * With scripts (html.js, set before paint in SiteHead), the filters take
   * their place in the first frame instead of pushing the cards down later.
   */
  :global(html.js) .showcase-filters[hidden] {
    display: flex;
  }
  .showcase-filters[hidden],
  .showcase-grid > :global([hidden]) {
    display: none;
  }
  .showcase-filters button {
    display: inline-flex;
    min-height: var(--control-size);
    align-items: baseline;
    gap: var(--space-3xs);
    padding: var(--space-2xs) 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--step--1);
    text-decoration: underline 2px transparent;
    text-underline-offset: 0.45em;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .showcase-filters button:hover {
    color: var(--color-text);
    text-decoration-color: var(--color-border-strong);
  }
  /* Pressed: darker, heavier text and an underline, not hue alone. */
  .showcase-filters button[aria-pressed="true"] {
    color: var(--color-text);
    font-weight: 600;
    text-decoration-color: var(--color-accent);
  }
  .showcase-filter-count {
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    font-weight: 400;
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-xs);
  }
  @media (max-width: 600px) {
    .portfolio-showcase {
      margin-block: var(--space-l) var(--space-xl);
    }
    /* One row that scrolls sideways instead of taking the first screen. */
    .showcase-filters {
      flex-wrap: nowrap;
      margin-inline: calc(-1 * var(--page-inline));
      /* Room for the focus outline, which the scroller would clip. */
      padding-inline: var(--page-inline);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }
    .showcase-filters button {
      flex: none;
    }
  }
</style>
