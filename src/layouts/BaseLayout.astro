---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/prose.css";
import "../styles/motion.css";
import SiteHead from "../components/site/SiteHead.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import type { Locale } from "../i18n/locales.ts";
import { useTranslations } from "../i18n/ui.ts";

export interface Props {
  lang: Locale;
  /** Page title; the home page (`home`) uses its own localized title. */
  title?: string;
  description: string;
  /** English path of the page (`/`, `/projects`…); locale URLs derive from it. */
  path: string;
  home?: boolean;
  noindex?: boolean;
  ogType?: "website" | "article";
  jsonLd?: object[];
  /** Locale switch target, for pages without a counterpart in the other locale. */
  localeHref?: string;
}
const { localeHref, ...head } = Astro.props;
const { lang, path, home = false } = head;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <SiteHead {...head} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("a11y.skipToContent")}
    </a>
    <div class="site-shell">
      <SiteHeader lang={lang} path={path} localeHref={localeHref} />
      <main id="main" class={home ? "site-home" : undefined}>
        <slot />
      </main>
      <SiteFooter lang={lang} />
    </div>
  </body>
</html>
